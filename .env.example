# Local development (SQLite file)
DATABASE_URL="file:./dev.db"

# Production (Turso libSQL).
#
# For the runtime client (src/lib/db.ts) set both:
#   DATABASE_URL="libsql://your-db-name.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOi..."
#
# For Prisma migrate / db push from the CLI (prisma.config.ts only reads `url`),
# embed the token in the URL instead:
#   DATABASE_URL="libsql://your-db-name.turso.io?authToken=eyJhbGciOi..."
